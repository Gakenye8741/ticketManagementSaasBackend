### Broadcast email to all registered users or a specific user
POST http://localhost:5000/api/users/send-email
Content-Type: application/json

{
  "subject": "Important Update from Event Management System",
  "htmlContent": "<p>Hello! We have an exciting new update regarding our upcoming events. Be sure to check your dashboard for details.</p>"
}

### Send email to a specific user by nationalId via the endpoint
POST http://localhost:5000/api/users/send-email
Content-Type: application/json

{
  "subject": "Personal Notice",
  "htmlContent": "<p>This is a direct notification message sent specifically to your account.</p>",
  "targetNationalId": 761181122
}